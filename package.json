{
  "name": "clack",
  "version": "0.1.0",
  "private": true,
  "description": "Clack — lightweight keyboard and mouse activity counter (Tauri 2 + TypeScript).",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/build.ts",
    "build:exe": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/build.ts --no-bundle",
    "collect": "node --no-warnings=ExperimentalWarning --experimental-strip-types scripts/copy-artifacts.ts",
    "icons": "tauri icon icons/icon-1024.png",
    "tsc": "tsc",
    "tsc:watch": "tsc -w",
    "type-check": "tsc --noEmit",
    "lint": "biome lint src scripts",
    "format": "biome format --write src scripts",
    "check": "biome check src scripts",
    "check:write": "biome check --write src scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^25.9.1",
    "http-server": "^14.1.1",
    "typescript": "^6.0.3"
  }
}
